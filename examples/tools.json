{
  "tools": [
    {
      "name": "discover_frameworks",
      "purpose": "Identify relevant regulations and standards, with maturity and version",
      "inputSchema": {
        "type": "object",
        "properties": {
          "framework_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "name": "assess_ai_system",
      "purpose": "Establish intended use, context, risk tier, and applicable checks",
      "inputSchema": {
        "type": "object",
        "properties": {
          "intended_use": {
            "type": "string"
          },
          "users": {
            "type": "string"
          },
          "data_types": {
            "type": "string"
          },
          "deployment": {
            "type": "string"
          },
          "high_risk_context": {
            "type": "boolean"
          }
        },
        "required": [
          "intended_use"
        ]
      }
    },
    {
      "name": "review_codebase",
      "purpose": "Inspect supplied code or project files against the governance checks and return findings with evidence",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "text": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "map_requirements",
      "purpose": "Map applicable requirements across selected frameworks",
      "inputSchema": {
        "type": "object",
        "properties": {
          "framework_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "name": "assess_ai_risks",
      "purpose": "Generate a structured risk register linked to checks",
      "inputSchema": {
        "type": "object",
        "properties": {
          "intended_use": {
            "type": "string"
          },
          "users": {
            "type": "string"
          },
          "data_types": {
            "type": "string"
          },
          "deployment": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "check_controls",
      "purpose": "Evaluate applicable, testable security and governance controls",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "generate_tests",
      "purpose": "Produce verification tests for selected or failed controls",
      "inputSchema": {
        "type": "object",
        "properties": {
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "project_name": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "generate_evidence",
      "purpose": "Assemble an evidence report from an assessment, or assess supplied files and report on them",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string"
          },
          "assessment": {
            "type": "object"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "review_changes",
      "purpose": "Reassess code changes against mapped requirements and show what was fixed or newly failed",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string"
          },
          "before_files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "after_files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "before_text": {
            "type": "string"
          },
          "after_text": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "explain_requirement",
      "purpose": "Explain a requirement with a source citation and applicability context, or state when a source is unavailable",
      "inputSchema": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "register_watch",
      "purpose": "Register a Fire-and-Forget watch: re-assess a stored project snapshot weekly or monthly and keep the latest report",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "schedule": {
            "type": "string",
            "enum": [
              "weekly",
              "monthly"
            ]
          },
          "email": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "project_name"
        ]
      }
    },
    {
      "name": "get_watch_report",
      "purpose": "Return the latest comprehensive report for a registered watch",
      "inputSchema": {
        "type": "object",
        "properties": {
          "watch_id": {
            "type": "string"
          }
        },
        "required": [
          "watch_id"
        ]
      }
    },
    {
      "name": "generate_audit_report",
      "purpose": "Generate a full ISO/IEC 42001 internal audit report: opinion, nonconformities, observations, corrective actions, and evidence trace",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "text": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_audit_report",
      "purpose": "Return a stored audit report by its audit ID",
      "inputSchema": {
        "type": "object",
        "properties": {
          "audit_id": {
            "type": "string"
          }
        },
        "required": [
          "audit_id"
        ]
      }
    },
    {
      "name": "get_about",
      "purpose": "About this MCP, its owner, contact details, install instructions, and limitations. For AI agents to introduce themselves and know who to contact.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "health_check",
      "purpose": "Agent self-test: server health, tool and check counts, and a sample verdict with latency",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "assess_prompt",
      "purpose": "Assess an AI agent prompt or system instruction for governance risks: secrets, personal data, instruction overrides, and exfiltration",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ]
      }
    },
    {
      "name": "review_agent_action",
      "purpose": "Assess an action an AI agent is about to take: risk level, verdict, and whether human approval is required before acting",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "data_type": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "check_agent_config",
      "purpose": "Review an AI agent configuration for risky permissions: shell, file writes, network, secrets, logging, and approval for destructive actions",
      "inputSchema": {
        "type": "object",
        "properties": {
          "config_text": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "generate_agent_policy",
      "purpose": "Generate a governance system-prompt snippet for an AI agent, tailored to selected frameworks",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string"
          },
          "framework_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "name": "get_example_prompts",
      "purpose": "Example prompts and tool sequences for AI agents using this MCP, from first discovery to audit",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "plan_next_steps",
      "purpose": "Turn an assessment into an ordered agent task list: fix failed checks first, then observations, then watch and audit",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          },
          "text": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        }
      }
    }
